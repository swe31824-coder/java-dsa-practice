class Solution {
    public boolean isPalindrome(int x) {
    
     int rem;
     if(x<0)
        return false;

        int original=x;
        int reverse=0;
     
     while(x!=0){
        rem=x%10;
        reverse=reverse*10+rem;
        x=x/10;
     } 
     
     return reverse==original;
    }
    
}
