class Solution {
    public int findMaxLength(int[] nums) {
        HashMap<Integer,Integer>map=new HashMap<>();
        map.put(0,-1);
        int maxLen=0;
        int sum=0;
        for(int i=0;i<nums.length;i++){
            if(nums[i]==0){
                sum+=-1;
            }
            else{
                sum+=1;
            }
            if(map.containsKey(sum)){
                int prevIndex=map.get(sum);
                int len=i-prevIndex;
                if(len>maxLen){
                    maxLen=len;
                }
            }
            else{
                map.put(sum,i);
            }
        }
        return maxLen;
    }
}
